# Copia este archivo como .env.local para desarrollo local.
# En producción, configura estas mismas variables en Vercel → Settings → Environment Variables.
# No pongas valores reales en este archivo: se sube a GitHub.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (o la "anon public" de la pestaña Legacy). Es pública; la protege RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# (o "service_role" en Legacy). SECRETA: solo en Vercel, nunca en el código.
SUPABASE_SERVICE_ROLE_KEY=

# Claves VAPID para Web Push. Genéralas en tu app en /configurar
# (se crean en tu navegador y no se envían a ningún lado).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contacto que exigen Apple/Google para push. Formato: mailto:tu-correo@ejemplo.com
VAPID_SUBJECT=

# Clave que usa Supabase Cron para llamar a /api/cron/reminders. Genérala en /configurar.
CRON_SECRET=
